# ============================================================================
# Project Organization - Folders to Ignore
# ============================================================================
# Logs (stored in backend/logs/)
backend/logs/*
!backend/logs/.gitkeep

# Temporary files (stored in backend/temp/)
backend/temp/*
!backend/temp/.gitkeep

# User uploads (stored in backend/uploads/)
backend/uploads/documents/*
!backend/uploads/documents/.gitkeep
backend/uploads/images/*
!backend/uploads/images/.gitkeep

# ============================================================================
# Application Logs
# ============================================================================
*.log
logs/

