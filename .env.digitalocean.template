# Cloud9 ERP - DigitalOcean Droplet Environment
# Copy this file to .env on the droplet and fill in DB_PASSWORD and JWT_SECRET.
# Do not commit the filled .env file.

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
APP_NAME=Cloud9 ERP

DB_USER=cloud9_user
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_DATABASE_PASSWORD
DB_NAME=cloud9_erp

# Generate on the droplet with:
# openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_64_CHARACTER_HEX_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Bootstrap admin. The app creates this account on first deployment if missing.
INITIAL_ADMIN_EMAIL=admin@cloud9.local
INITIAL_ADMIN_PASSWORD=Admin@12345

# Public domain. Caddy requests the Let's Encrypt certificate for this name,
# so the DNS A record for it must already point at this droplet.
DOMAIN=erp.thecloud9corp.com

# Same-origin API through Caddy: frontend calls /api and Caddy proxies to backend.
VITE_API_URL=/api
CORS_ORIGINS=https://erp.thecloud9corp.com
ALLOWED_HOSTS=erp.thecloud9corp.com,localhost,127.0.0.1

# Optional DigitalOcean Spaces uploads
# DO_SPACES_KEY=
# DO_SPACES_SECRET=
# DO_SPACES_BUCKET=cloud9-erp-uploads
# DO_SPACES_REGION=sfo3
# DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
# DO_SPACES_CDN_URL=
